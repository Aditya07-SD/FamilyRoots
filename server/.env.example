# Development email OTP (Gmail SMTP)
EMAIL_VERIFICATION_MODE=smtp
EMAIL_VERIFICATION_CODE_EXPIRES_MINUTES=10
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_APP_PASSWORD=your-google-app-password

# Existing Resend settings (preserved for future)
EMAIL_FROM=FamilyRoots <noreply@example.com>
EMAIL_API_KEY=
